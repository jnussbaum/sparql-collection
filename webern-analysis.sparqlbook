[
  {
    "kind": 2,
    "language": "sparql",
    "value": "# RESOURCE TO BE DELETED\n\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX kb: <http://www.knora.org/ontology/knora-base#>\nPREFIX webern: <http://www.knora.org/ontology/0806/webern-onto#>\n\nSELECT * WHERE {\n    <http://rdfh.ch/0806/eD83lLUSSYCbEOb5B5cknQ> ?p ?o\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "# RESOURCE IS IN OBJECT POSITION OF\n\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX kb: <http://www.knora.org/ontology/knora-base#>\nPREFIX webern: <http://www.knora.org/ontology/0806/webern-onto#>\n\nSELECT * WHERE {\n    ?s a ?type ; \n        ?p <http://rdfh.ch/0806/eD83lLUSSYCbEOb5B5cknQ> .\n    OPTIONAL { ?s kb:isDeleted ?deleted }\n    FILTER (?p != rdf:subject)  # exclude reifications, where the resource is in subject position\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "# Finding so far: There is a non-deleted resource with a richtext value that links to the resource that we want to delete.\n# THIS STANDOFF LINK TAG HAS A LINK TO THE RESOURCE THAT SHOULD BE DELETED\n\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX kb: <http://www.knora.org/ontology/knora-base#>\nPREFIX webern: <http://www.knora.org/ontology/0806/webern-onto#>\n\nSELECT * WHERE {\n    <http://rdfh.ch/0806/Tr7j5V37TWOQjNgIJ6VKnA/values/D0z8VcR3Qzi2K2BI3HPXKg/standoff/2> ?p ?o\n}\n",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "# SUBJECT IS THE TEXT VALUE WHERE THE PROBLEMATIC STANDOFF IS EMBEDDED\n# THE TEXT VALUE ITSELF IS NOT DELETED\n\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX kb: <http://www.knora.org/ontology/knora-base#>\nPREFIX ka: <http://www.knora.org/ontology/knora-admin#>\n\nSELECT ?s ?deleted ?prev WHERE {\n    ?s ?p <http://rdfh.ch/0806/Tr7j5V37TWOQjNgIJ6VKnA/values/D0z8VcR3Qzi2K2BI3HPXKg/standoff/2> .\n    ?s kb:previousValue ?prev .\n    ?s kb:isDeleted ?deleted .\n}\n",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "# Property of this value is :hasBiography\n\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX kb: <http://www.knora.org/ontology/knora-base#>\n\nSELECT ?prop WHERE {\n    ?res ?prop <http://rdfh.ch/0806/Tr7j5V37TWOQjNgIJ6VKnA/values/D0z8VcR3Qzi2K2BI3HPXKg>\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "# THIS TEXT VALUE IS THE CURRENT VALUE AND CANNOT BE DELETED\n\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX kb: <http://www.knora.org/ontology/knora-base#>\nPREFIX ka: <http://www.knora.org/ontology/knora-admin#>\nPREFIX project: <http://www.knora.org/ontology/4123/testonto#>\n\nSELECT * WHERE {\n    <http://rdfh.ch/0806/Tr7j5V37TWOQjNgIJ6VKnA/values/kkJEdxkqRjOu6J8eveKR2Q> ?p ?o\n}",
    "metadata": {}
