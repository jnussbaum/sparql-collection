[
  {
    "kind": 1,
    "language": "markdown",
    "value": "# Investigate DB size issue after BEOL graph replacement (DEV-4884)\n\nInvestigate why prod db backup plunged from 10.9 GB to 7.7 GB after BEOL graph replacement.\n\n## Count triples in all graphs",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "SELECT ?g (COUNT(?s) AS ?tripleCount)\nWHERE {\n  GRAPH ?g {?s ?p ?o}\n}\nGROUP BY ?g ?tripleCount",
    "metadata": {}
  },
  {
    "kind": 1,
    "language": "markdown",
    "value": "## Société Savoie: Resources that were created/modified on 2025-04-28\n\nThe data graph of Société Savoie has grown by 2700 triples on 2025-04-28.",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nPREFIX knora-admin: <http://www.knora.org/ontology/knora-admin#>\nPREFIX kb: <http://www.knora.org/ontology/knora-base#>\n\nSELECT * WHERE {\n    GRAPH <http://www.knora.org/data/0121/societe-savoie> {\n        ?s kb:creationDate ?creationDateTime .\n        FILTER(\n            xsd:date(?creationDateTime) = \"2025-04-28Z\"^^xsd:date\n        ) .\n    }\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nPREFIX knora-admin: <http://www.knora.org/ontology/knora-admin#>\nPREFIX kb: <http://www.knora.org/ontology/knora-base#>\n\nSELECT * WHERE {\n    GRAPH <http://www.knora.org/data/0121/societe-savoie> {\n        ?s kb:lastModificationDate ?lmdDateTime .\n        FILTER(\n            xsd:date(?lmdDateTime) = \"2025-04-28Z\"^^xsd:date\n        ) .\n    }\n}",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nPREFIX knora-admin: <http://www.knora.org/ontology/knora-admin#>\nPREFIX kb: <http://www.knora.org/ontology/knora-base#>\n\nSELECT ?res ?resCreationDate WHERE {\n    GRAPH <http://www.knora.org/data/0121/societe-savoie> {\n        ?val kb:valueCreationDate ?valueCreationDate .\n        FILTER(\n            xsd:date(?valueCreationDate) = \"2025-04-28Z\"^^xsd:date\n        ) .\n        ?res ?p ?val ;\n             kb:creationDate ?resCreationDate .\n        # FILTER(\n        #     xsd:date(?resCreationDate) != \"2025-04-28Z\"^^xsd:date\n        # ) .\n    }\n}\nLIMIT 10",
    "metadata": {}
  },
  {
    "kind": 1,
    "language": "markdown",
    "value": "## Count direct resource triples of these 56 resources: 542",
    "metadata": {}
  },
  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nPREFIX knora-admin: <http://www.knora.org/ontology/knora-admin#>\nPREFIX kb: <http://www.knora.org/ontology/knora-base#>\n\nSELECT (COUNT(*) as ?counter) WHERE {\n    GRAPH <http://www.knora.org/data/0121/societe-savoie> {\n        VALUES ?res {\n            <http://rdfh.ch/0121/MdyJG3VYTBGSgDflG7_NSA>\n            <http://rdfh.ch/0121/C0N_rbSWRRuL579hmlNlWw>\n            <http://rdfh.ch/0121/cN_OyKwpROqa9OIKSRHwKQ>\n            <http://rdfh.ch/0121/UaY4yKhWSEeTQa1qHQmKXw>\n            <http://rdfh.ch/0121/MZJxI8neSTWCtziXsLiRkg>\n            <http://rdfh.ch/0121/efhSh1tXTd6pWJQKh-Dpzw>\n            <http://rdfh.ch/0121/3eRmFEdvTgG_zXLuCvbmnA>\n            <http://rdfh.ch/0121/CZrzr-HjTc2ARSTFt0jneA>\n            <http://rdfh.ch/0121/18v3xcnzREuqCiVatvpnNw>\n            <http://rdfh.ch/0121/bZS7kNQjRJqHxep1g_avNA>\n            <http://rdfh.ch/0121/3xrOcFwJQfqnEAGbWc1SsA>\n            <http://rdfh.ch/0121/czEgOvo0RxO0N9fP4sIFgw>\n            <http://rdfh.ch/0121/94C0oG0oTv-qxBYwbi0VgA>\n            <http://rdfh.ch/0121/NBhvnVjvS2SwfKfxZqO-kw>\n            <http://rdfh.ch/0121/zvIVq0oqSwmFyavfbWFF0A>\n            <http://rdfh.ch/0121/qM9OMp0xQim_onTl8O1LLA>\n            <http://rdfh.ch/0121/e3HcJH6wTcKzXX5aNmPcMw>\n            <http://rdfh.ch/0121/8iA0DDGYSrGYA_biGKRNsw>\n            <http://rdfh.ch/0121/cJbbO4TETS2Jg9ejGTUKzw>\n            <http://rdfh.ch/0121/YqsyWWCzSK2DPNW1oTfGYQ>\n            <http://rdfh.ch/0121/LTswmU8HTI-uuxUyJft8lQ>\n            <http://rdfh.ch/0121/CEmttU3MS4KKU2saCrIt-Q>\n            <http://rdfh.ch/0121/a7zUO-E1RSuU5h8gf1Q2bA>\n            <http://rdfh.ch/0121/SaAeAojCSgOjjmK8t2ld8A>\n            <http://rdfh.ch/0121/GM1f2lKqQd226tesBs2fBQ>\n            <http://rdfh.ch/0121/rVkA-SxgQLad2vBfn1oFew>\n            <http://rdfh.ch/0121/A_BgkyBRR_O9JfS1cMiS_w>\n            <http://rdfh.ch/0121/b7z5ckavSEGh8LVq45bm0Q>\n            <http://rdfh.ch/0121/NOuQAXNNSyuT8MKc0RXb5A>\n        