  {
    "kind": 2,
    "language": "sparql",
    "value": "PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nPREFIX kb: <http://www.knora.org/ontology/knora-base#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\n\nSELECT (COUNT(*) as ?count) WHERE {\n  VALUES ?res {\n    <http://rdfh.ch/0121/MdyJG3VYTBGSgDflG7_NSA>\n    <http://rdfh.ch/0121/C0N_rbSWRRuL579hmlNlWw>\n    <http://rdfh.ch/0121/cN_OyKwpROqa9OIKSRHwKQ>\n    <http://rdfh.ch/0121/UaY4yKhWSEeTQa1qHQmKXw>\n    <http://rdfh.ch/0121/MZJxI8neSTWCtziXsLiRkg>\n    <http://rdfh.ch/0121/efhSh1tXTd6pWJQKh-Dpzw>\n    <http://rdfh.ch/0121/3eRmFEdvTgG_zXLuCvbmnA>\n    <http://rdfh.ch/0121/CZrzr-HjTc2ARSTFt0jneA>\n    <http://rdfh.ch/0121/18v3xcnzREuqCiVatvpnNw>\n    <http://rdfh.ch/0121/bZS7kNQjRJqHxep1g_avNA>\n    <http://rdfh.ch/0121/3xrOcFwJQfqnEAGbWc1SsA>\n    <http://rdfh.ch/0121/czEgOvo0RxO0N9fP4sIFgw>\n    <http://rdfh.ch/0121/94C0oG0oTv-qxBYwbi0VgA>\n    <http://rdfh.ch/0121/NBhvnVjvS2SwfKfxZqO-kw>\n    <http://rdfh.ch/0121/zvIVq0oqSwmFyavfbWFF0A>\n    <http://rdfh.ch/0121/qM9OMp0xQim_onTl8O1LLA>\n    <http://rdfh.ch/0121/e3HcJH6wTcKzXX5aNmPcMw>\n    <http://rdfh.ch/0121/8iA0DDGYSrGYA_biGKRNsw>\n    <http://rdfh.ch/0121/cJbbO4TETS2Jg9ejGTUKzw>\n    <http://rdfh.ch/0121/YqsyWWCzSK2DPNW1oTfGYQ>\n    <http://rdfh.ch/0121/LTswmU8HTI-uuxUyJft8lQ>\n    <http://rdfh.ch/0121/CEmttU3MS4KKU2saCrIt-Q>\n    <http://rdfh.ch/0121/a7zUO-E1RSuU5h8gf1Q2bA>\n    <http://rdfh.ch/0121/SaAeAojCSgOjjmK8t2ld8A>\n    <http://rdfh.ch/0121/GM1f2lKqQd226tesBs2fBQ>\n    <http://rdfh.ch/0121/rVkA-SxgQLad2vBfn1oFew>\n    <http://rdfh.ch/0121/A_BgkyBRR_O9JfS1cMiS_w>\n    <http://rdfh.ch/0121/b7z5ckavSEGh8LVq45bm0Q>\n    <http://rdfh.ch/0121/NOuQAXNNSyuT8MKc0RXb5A>\n    <http://rdfh.ch/0121/zzVqjI9qTOinYfvLEuK-Aw>\n    <http://rdfh.ch/0121/FBunhpx6QTGHnWztM5bXFQ>\n    <http://rdfh.ch/0121/DYPYxdTPTCWtXxHIzFl6pA>\n    <http://rdfh.ch/0121/C86qmjzYQ5KO8Pt7KfKlxw>\n    <http://rdfh.ch/0121/ATsYP4TLTYaDZ0-vsHVA1Q>\n    <http://rdfh.ch/0121/QMpOmDtnRZyzYp1ikYvpoA>\n    <http://rdfh.ch/0121/ZU_lpLzMTKCAP71_-MJfzQ>\n    <http://rdfh.ch/0121/R50gfPxxRamNJXhPpaUk3A>\n    <http://rdfh.ch/0121/CrZaFPhoTVWzQheJ7RilCQ>\n    <http://rdfh.ch/0121/wydH8Hi5RBysQdiG7X_sLA>\n    <http://rdfh.ch/0121/xlkHiJeMTsCu0DR9U2GPUw>\n    <http://rdfh.ch/0121/33gqiq7STDWXnO0olh_Eew>\n    <http://rdfh.ch/0121/Y3zgVAnTQSa_5ZaElJd7Hg>\n    <http://rdfh.ch/0121/h_Y547r0Tx6Tv4nb63UYJA>\n    <http://rdfh.ch/0121/jfOtq4iBRQGrRrP2256hcw>\n    <http://rdfh.ch/0121/NsI_bSdESq6YOaepnJCkag>\n    <http://rdfh.ch/0121/olnIIB8eSdinTbZA0X6srg>\n    <http://rdfh.ch/0121/-tu6GsJRSxy1QAABrkJpoQ>\n    <http://rdfh.ch/0121/ZRkig84nSDymETImzCJxmQ>\n    <http://rdfh.ch/0121/ChqkbBqlReK69O1ljzLCYA>\n    <http://rdfh.ch/0121/qJXi6SUFQQG6sbnOynbu7g>\n    <http://rdfh.ch/0121/wippCXd2RJuzdKLBK0hhUA>\n    <http://rdfh.ch/0121/LDM4OYpPRW65YsZOUrg6xA>\n    <http://rdfh.ch/0121/UCbwq2K-TGeAuzxo56NgkQ>\n    <http://rdfh.ch/0121/LVcI5LtfQKaoqPSSSxL8Mw>\n    <http://rdfh.ch/0121/6-F7auejTga345-kpiHJ-g>\n    <http://rdfh.ch/0121/fR88BcAaSbihAwXoNiHmPA>\n  }\n  \n  ?res ?p ?val .\n  \n  # filter out direct links because they bring us to other resources\n  # and we don't want to traverse things outgoing from other resources\n  FILTER NOT EXISTS {\n    ?val a ?otype.\n    ?otype rdfs:subClassOf* kb:Resource\n  }\n  \n  ?val kb:valueHasStandoff ?standoff .\n  \n  ?standoff ?x ?y .\n  \n  # filter out triples that go to ontology, user, project\n  FILTER (?p != rdf:type)\n  FILTER (?p != kb:attachedToProject)\n  FILTER (?p != kb:attachedToUser)\n}",
